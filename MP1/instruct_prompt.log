    doctest.testmod()

# Alternative solution
def sum_product_alt(numbers: List[int]) -> Tuple[int, int]:
    total_sum = 0
    total_product = 1
    for num in numbers:
        total_sum += num
        total_product *= num
    return (total_sum, total_product if numbers else 1)

