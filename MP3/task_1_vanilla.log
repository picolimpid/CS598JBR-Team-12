public class Main {
    public static void main(String[] args) {
        System.out.println(checkIfLastCharIsLetter("Hello World"));
    }

    public static boolean checkIfLastCharIsLetter(String txt) {
        String check = txt.split(" ")[txt.split(" ").length - 1];
        if (check.length() == 1) {
            char lastChar = check.charAt(0);
            if ((lastChar >= 'a' && lastChar <= 'z') || (lastChar >= 'A' && lastChar <= 'Z')) {
