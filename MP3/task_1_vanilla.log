import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        int[] lst = {1, 2, 3, 4, 4, 4, 5, 5, 5, 5, 5};
        System.out.println(search(lst));
    }

    public static int search(int[] lst) {
        int max = Arrays.stream(lst).max().getAsInt();
        int[] frq = new int[max + 1];
        for (int i : lst) {
            frq[i]++;
        }

        int ans = -1;
        for (int i = 1; i < frq.length; i++) {
            if (frq[i] >= i) {
                ans = i;
            }
        }

        return ans;
    }
}

