{
  "_comment": "Main pipeline configuration. Variants (config.gemini.json, config.local_vllm.json, ...) 'extend' this file and override only the llm section. API keys are NEVER stored here: llm.api_key_env holds the *name* of the environment variable.",

  "toolchain": "nightly-2025-05-13",

  "llm": {
    "provider": "openrouter",
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "model": "qwen/qwen3-coder:free",
    "tool_mode": "native",
    "temperature": 0.2,
    "top_p": 0.95,
    "max_tokens": 16384,
    "seed": 598,
    "parallel_tool_calls": null,
    "request_timeout_s": 600,
    "max_retries": 8,
    "max_backoff_s": 120,
    "min_seconds_between_requests": 4,
    "extra_headers": {"X-Title": "CS598JBR-MP4-c2rust-agent"},
    "extra_body": {}
  },

  "budget": {
    "_comment": "Stopping condition: stop at the first of (a) success_criteria all met, (b) max_iterations agent iterations, (c) max_llm_calls / max_total_tokens / wall_clock_limit_min exhausted, (d) `patience` consecutive iterations without a better score.",
    "max_iterations": 10,
    "max_steps_per_iteration": 30,
    "max_nudges": 3,
    "max_llm_calls": 300,
    "max_total_tokens": 15000000,
    "wall_clock_limit_min": 240,
    "patience": 3
  },

  "success_criteria": {
    "require_interface_ok": true,
    "require_no_unimplemented": true,
    "max_unsafe_primary": 0,
    "max_clippy_warnings": 0,
    "max_rustc_warnings": null
  },

  "policy": {
    "_comment": "inject_forbid_unsafe adds #![forbid(unsafe_code)] to the crate roots so any unsafe becomes a compile error the agent must repair. format_final runs rustfmt on the agent's files (never on benchmark tests) after the loop.",
    "inject_forbid_unsafe": true,
    "format_final": true
  },

  "context": {
    "inline_c_sources": false,
    "inline_rust_max_chars": 120000,
    "max_context_chars": 400000,
    "keep_recent_messages": 10
  },

  "feedback": {
    "max_items": 12,
    "max_section_chars": 12000
  },

  "tools": {
    "schema_file": "configs/tools.json",
    "max_read_chars": 60000,
    "max_tool_output_chars": 16000,
    "log_tool_result_chars": 8000,
    "log_command_output_chars": 20000,
    "log_diff_chars": 40000,
    "check_interface_on_write": true,
    "use_newmetrics": true,
    "timeouts_s": {"build": 300, "test": 300, "clippy": 300, "metrics": 900}
  },

  "prompts": {
    "dir": "configs/prompts",
    "files": {
      "system": "system.md",
      "initial_task": "initial_task.md",
      "repair_task": "repair_task.md",
      "text_protocol": "text_tool_protocol.md",
      "nudge": "nudge.md",
      "truncated_nudge": "truncated_nudge.md"
    }
  }
}
